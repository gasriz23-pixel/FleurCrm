generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {\n  ADMIN\n  COMMERCIAL\n  BACKOFFICE\n}

// ADMIN e COMMERCIAL sono operatori full-access; BACKOFFICE è limitato alle funzioni operative.
enum LeadStatus {\n  NEW\n  CONTACTED\n  QUALIFIED\n  OPPORTUNITY\n  WON\n  LOST\n}
enum TaskStatus {\n  TODO\n  IN_PROGRESS\n  DONE\n  CANCELLED\n}
enum Priority {\n  LOW\n  MEDIUM\n  HIGH\n  URGENT\n}
enum SearchJobStatus {\n  QUEUED\n  RUNNING\n  COMPLETED\n  FAILED\n  CANCELLED\n}
enum EnrichmentJobStatus {\n  QUEUED\n  RUNNING\n  COMPLETED\n  FAILED\n  CANCELLED\n}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  role UserRole @default(COMMERCIAL)
  createdAt DateTime @default(now())
  passwordHash String?
  updatedAt DateTime @updatedAt
  assignedTasks Task[] @relation("TaskAssignee")
  createdTasks Task[] @relation("TaskCreator")
  auditLogs AuditLog[]
  campaigns Campaign[] @relation("CampaignCreator")
}

model Company {
  id String @id @default(cuid())
  name String
  normalizedName String
  identityKey String @unique
  category String?
  address String?
  city String?
  province String?
  region String?
  cap String?
  website String?
  normalizedWebsite String?
  phone String?
  email String?
  status LeadStatus @default(NEW)
  rating Float?
  reviewCount Int?
  roomsOrSeats Int?
  decisionMakerName String?
  decisionMakerRole String?
  linkedinUrl String?
  confidence Float @default(0)
  lastVerifiedAt DateTime?
  sourceUrl String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contacts Contact[]
  tasks Task[]
  sources LeadSource[]
  enrichmentJobs EnrichmentJob[]
  campaignRecipients CampaignRecipient[]
  @@index([city])
  @@index([province])
  @@index([region])
  @@index([cap])
  @@index([category])
  @@index([status])
  @@index([normalizedWebsite])
  @@index([normalizedName, city])
  @@index([deletedAt])
}

model Contact {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete: Cascade)
  name String?
  role String?
  email String?
  phone String?
  linkedinUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
  @@index([email])
}

model LeadSource {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete: Cascade)
  provider String
  url String?
  verifiedAt DateTime?
  rawConfidence Float @default(0)
  createdAt DateTime @default(now())
  @@unique([companyId, provider, url])
  @@index([companyId])
  @@index([provider])
}

model Task {
  id String @id @default(cuid())
  title String
  description String?
  status TaskStatus @default(TODO)
  priority Priority @default(MEDIUM)
  dueAt DateTime?
  assigneeId String?
  assignee User? @relation("TaskAssignee", fields:[assigneeId], references:[id])
  creatorId String?
  creator User? @relation("TaskCreator", fields:[creatorId], references:[id])
  companyId String?
  company Company? @relation(fields:[companyId], references:[id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([assigneeId,status])
  @@index([dueAt])
  @@index([companyId,status])
}

model SearchJob {
  id String @id @default(cuid())
  status SearchJobStatus @default(QUEUED)
  query String
  city String?
  province String?
  region String?
  cap String?
  radiusKm Float?
  categories Json
  filters Json?
  progress Int @default(0)
  totalFound Int @default(0)
  error String?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chunks SearchJobChunk[]
  @@index([status,createdAt])
}

model SearchJobChunk {
  id String @id @default(cuid())
  searchJobId String
  searchJob SearchJob @relation(fields:[searchJobId], references:[id], onDelete: Cascade)
  sequence Int
  location String
  status SearchJobStatus @default(QUEUED)
  progress Int @default(0)
  found Int @default(0)
  error String?
  attempts Int @default(0)
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([searchJobId,sequence])
  @@index([searchJobId,status])
}

model EnrichmentJob {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields:[companyId], references:[id], onDelete: Cascade)
  status EnrichmentJobStatus @default(QUEUED)
  progress Int @default(0)
  pagesVisited Int @default(0)
  fieldsFound Int @default(0)
  error String?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId,createdAt])
  @@index([status,createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId], references:[id], onDelete: SetNull)
  entityType String
  entityId String
  action String
  payload Json?
  createdAt DateTime @default(now())
  @@index([entityType,entityId])
  @@index([userId,createdAt])
}


enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  FAILED
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  OPENED
  CLICKED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

model Campaign {
  id String @id @default(cuid())
  name String
  subject String
  htmlBody String
  textBody String?
  status CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipients CampaignRecipient[]
  @@index([status, scheduledAt])
  @@index([createdById, createdAt])
}

model CampaignRecipient {
  id String @id @default(cuid())
  campaignId String
  companyId String
  email String
  status EmailDeliveryStatus @default(QUEUED)
  providerMessageId String?
  sentAt DateTime?
  openedAt DateTime?
  clickedAt DateTime?
  error String?
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([campaignId, companyId])
  @@index([campaignId, status])
  @@index([companyId, createdAt])
}

model EmailUnsubscribe {
  id String @id @default(cuid())
  email String @unique
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
